<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="lens">
  <schema id="io.github.seed43.lens" path="/io/github/seed43/lens/">
    <!-- Window params -->
    <key name="window-width" type="i">
      <default>-1</default>
      <summary>Default window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>-1</default>
      <summary>Default window height</summary>
    </key>

    <key name="sidebar-width" type="i">
      <default>240</default>
      <summary>Sidebar width</summary>
    </key>

    <key name="history-width" type="i">
      <default>180</default>
      <summary>History panel width</summary>
    </key>

    <key name="history-days" type="i">
      <default>30</default>
      <summary>Days to keep history</summary>
    </key>

    <key name="ocr-engine" type="s">
      <default>"tesseract"</default>
      <summary>Active OCR engine</summary>
    </key>

    <key name="extra-language" type="s">
      <default>"eng"</default>
      <summary>Extra language</summary>
      <description>Language to detect alongside with the active one.</description>
    </key>
    <key name="active-language" type="s">
      <default>"eng"</default>
      <summary>Active language</summary>
      <description>Active language to extract the text.</description>
    </key>
    <key name="autocopy" type="b">
      <default>false</default>
      <summary>Autocopy text to clipboard</summary>
      <description>Automatically copy the extracted text to the clipboard.</description>
    </key>
    <key name="autolinks" type="b">
      <default>false</default>
      <summary>Open QR-code links</summary>
      <description>Automatically open links from QR-codes</description>
    </key>
    <key name="delete-screenshot" type="b">
      <default>true</default>
      <summary>Delete screenshot after extraction</summary>
      <description>Remove the captured screenshot file once text has been extracted from it.</description>
    </key>
  </schema>
</schemalist>
