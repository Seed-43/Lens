<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
    <id>io.github.seed43.lens</id>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0-or-later</project_license>
    <name>Lens</name>
    <summary>Extract text from anything on your screen</summary>

    <description>
        <p>
            Lens is a simple OCR tool for GNOME. Point it at anything on your
            screen and pull the text out. Take a screenshot, open an image file,
            or paste an image from your clipboard.
        </p>
        <p>Features:</p>
        <ul>
            <li>Extract text from screenshots, images and clipboard</li>
            <li>Choose between Tesseract, EasyOCR, PaddleOCR and docTR, with in-app download and update checks for each engine</li>
            <li>Drag and drop image files directly onto the window</li>
            <li>QR code detection and decoding</li>
            <li>Multi-language OCR support, including a secondary language</li>
            <li>Auto-copy extracted text to clipboard</li>
            <li>Searchable extraction history with configurable retention</li>
            <li>Optionally keep or discard the screenshot after extraction</li>
            <li>System-wide hotkey support</li>
            <li>Wayland native</li>
        </ul>
    </description>

