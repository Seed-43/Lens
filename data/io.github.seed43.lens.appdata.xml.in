    <releases>
        <release version="1.7.0" type="stable" date="2026-07-18">
            <description translate="no">
                <p>OCR engine rebuild and settings overhaul.</p>
                <ul>
                    <li>Fixed EasyOCR, PaddleOCR and docTR — engine selection now works end to end</li>
                    <li>Added in-app update checks and one-click updates for installed engines</li>
                    <li>Automatic fallback to Tesseract if another engine fails</li>
                    <li>New option to keep the screenshot instead of deleting it after extraction</li>
                    <li>Clearer progress messages while text is being extracted</li>
                    <li>Sidebar and content areas redesigned to match the GNOME Files layout</li>
                </ul>
            </description>
        </release>
        <release version="1.6.0" type="stable" date="2026-04-18">
            <description translate="no">
                <p>Initial release of Lens by Seed-43.</p>
                <ul>
                    <li>Completely redesigned UI following GNOME HIG</li>
                    <li>Persistent sidebar with Lens and Settings tabs</li>
                    <li>System-wide hotkey configuration</li>
                    <li>Wayland-only, no X11 support</li>
                    <li>Telemetry and tracking removed</li>
                    <li>GPL-3.0 licensed</li>
                </ul>
            </description>
        </release>
    </releases>

    <developer_name translate="no">Seed-43</developer_name>
    <developer id="io.github.seed43">
        <name translate="no">Seed-43</name>
    </developer>

    <launchable type="desktop-id">io.github.seed43.lens.desktop</launchable>
