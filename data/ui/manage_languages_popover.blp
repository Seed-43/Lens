using Gtk 4.0;

template $ManageLanguagesPopover : Popover {

  show => $_on_popover_show();
  closed => $_on_popover_closed();
  styles ["menu"]

  Box {
    orientation: vertical;
    width-request: 280;

    Box {
      orientation: vertical;
      margin-top: 6;
      margin-bottom: 4;
      margin-start: 6;
      margin-end: 6;

      SearchEntry search_entry {
        placeholder-text: _("Search languages…");
        search-changed => $_on_search_changed();
        stop-search => $_on_stop_search();
      }
    }

    Separator {}

    Stack views {
      transition-type: crossfade;

      StackPage {
        name: "languages";
        child: ScrolledWindow {
          height-request: 240;
          hscrollbar-policy: never;

          ListBox list_view {
            selection-mode: none;
            styles ["separators"]
          }
        };
      }

      StackPage {
        name: "empty";
        child: Box {
          orientation: vertical;
          height-request: 120;
          valign: center;
          halign: center;
          spacing: 8;
          margin-top: 16;
          margin-bottom: 16;

          Image {
            icon-name: "system-search-symbolic";
            pixel-size: 32;
            styles ["dim-label"]
          }

          Label {
            label: _("No languages found");
            styles ["dim-label"]
          }
        };
      }
    }
  }
}
