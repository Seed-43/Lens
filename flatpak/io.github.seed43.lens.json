{
    "app-id": "io.github.seed43.lens",
    "runtime": "org.gnome.Platform",
    "runtime-version": "49",
    "sdk": "org.gnome.Sdk",
    "command": "lens",
    "finish-args": [
        "--share=network",
        "--socket=wayland",
        "--device=dri",
        "--talk-name=org.freedesktop.Notifications",
        "--filesystem=xdg-pictures",
        "--talk-name=org.gnome.settings-daemon.plugins.media-keys",
        "--metadata=X-DConf=migrate-path=/io/github/seed43/lens/",
        "--talk-name=org.freedesktop.Flatpak"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "blueprint-compiler",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/jwestman/blueprint-compiler.git",
                    "tag": "v0.16.0"
                }
            ]
        },
        "leptonica.json",
        "tesseract.json",
        "libportal.json",
        "zbar.json",
        "python3-modules.json",
        {
            "name": "lens",
            "builddir": true,
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/Seed-43/Lens.git",
                    "tag": "v1.7.0"
                }
            ]
        }
    ]
}